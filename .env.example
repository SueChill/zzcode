DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 可选：手动覆盖底栏显示名；留空优先从 /models 自动获取。
MODEL_DISPLAY_NAME=
# 可选：手动覆盖上下文容量（输入+输出 token）；留空自动获取，查询不到则不显示百分比。
MODEL_CONTEXT_WINDOW=
# 可选：每次请求最多输出的 token 数（含思考）；留空自动预留，另留 5% 窗口安全余量。
MODEL_MAX_OUTPUT_TOKENS=
# 思考控制：留空或 auto 使用接口默认；enabled 开启，disabled 关闭。
MODEL_THINKING=auto
# DeepSeek：low/high/max；千问 3.8 Flash/Max：low/medium/xhigh。留空使用默认力度。
MODEL_REASONING_EFFORT=

# 可选模型列表，按顺序切换；留空仅使用上面的默认模型。Alt+M 切换，/model 查看。
MODEL_PROFILES=
# 例如启用默认模型和千问，取消下面各行注释并填写千问密钥：
# MODEL_PROFILES=default,qwen
# MODEL_QWEN_API_KEY=
# MODEL_QWEN_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
# MODEL_QWEN_ID=qwen3.8-flash
# MODEL_QWEN_DISPLAY_NAME=Qwen3.8-Flash
# MODEL_QWEN_CONTEXT_WINDOW=1000000
# MODEL_QWEN_MAX_OUTPUT_TOKENS=
# MODEL_QWEN_THINKING=auto
# MODEL_QWEN_REASONING_EFFORT=

# 联网搜索可选配置；不填时使用 Tavily 的免密钥模式。
TAVILY_API_KEY=
SHOW_REASONING=true

# 可选：GitHub MCP 使用的个人访问令牌。配置位于 zzcode 安装目录的 mcp.json。
GITHUB_TOKEN=

# 本地追踪默认开启；也可通过启动参数 --no-trace 关闭。
TRACE_ENABLED=true
# 默认只记元数据，不保存参数或结果正文；开启预览时最多 2000 字符。
TRACE_PREVIEW_CHARS=0
# 单次任务日志的软告警阈值（MiB），不自动轮转或删除历史。
TRACE_MAX_MB=32

